    "cors": "^2.8.6",
    "dotenv": "^18.0.10",
    "express": "^5.1.0",
    "express-rate-limit": "^8.7.5",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.12.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.4"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "vite": "^8.3.8"
  }
}
