{
  "name": "real-time-chat-application",
  "version": "1.0.0",
  "private": true,
  "description": "Real-time chat application server",
  "main": "server.js",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "concurrently -k -n server,client \"node --watch server.js\" \"vite\"",
